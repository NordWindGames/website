---
import Analytics from '../components/Analytics.astro';
import Seo from '../components/Seo.astro';
import { SOCIAL_CHANNELS, DISCORD_INVITE } from '../lib/social';
import { blogIndexPath, otherLocale, type Locale } from '../lib/blog';
import type { Alternate, OgImage } from '../lib/seo';

interface Props {
	title: string;
	description: string;
	locale: Locale;
	/**
	 * Where the language switcher points. Defaults to the other locale's devlog
	 * index; a post passes the translated post instead, so switching language
	 * keeps you on what you were reading rather than dumping you at the index.
	 */
	altLocaleHref?: string;
	/**
	 * Passed straight through to <Seo />. The layout decides none of it: which
	 * pages may claim an hreflang cluster, carry an article date or stay out of
	 * the index is a per-route question, and answering it here would mean
	 * guessing from the locale prop.
	 */
	alternates?: Alternate[];
	noindex?: boolean;
	type?: 'website' | 'article';
	image?: OgImage;
	publishedTime?: Date;
	modifiedTime?: Date;
	feed?: string;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
	title,
	description,
	locale,
	altLocaleHref,
	alternates,
	noindex,
	type,
	image,
	publishedTime,
	modifiedTime,
	feed,
	jsonLd,
} = Astro.props;
// The landing page is English-only, so both locales' brand link goes there. A
// '/de/' home would be a 404: GitHub Pages serves static files with no rewrite,
// and there is no src/pages/de/index.astro to build one from.
const home = '/';
const blogHome = blogIndexPath(locale);
const alt = otherLocale(locale);
const altHref = altLocaleHref ?? blogIndexPath(alt);
const altLabel = alt === 'de' ? 'Deutsch' : 'English';

const t =
	locale === 'de'
		? { follow: 'Folge der Entwicklung', talk: 'Reden wir', discord: 'Discord beitreten' }
		: { follow: 'Follow the development', talk: 'Come talk', discord: 'Join the Discord' };
---

<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<Seo
			{title}
			{description}
			{locale}
			{alternates}
			{noindex}
			{type}
			{image}
			{publishedTime}
			{modifiedTime}
			{feed}
			{jsonLd}
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Silkscreen:wght@400;700&display=swap"
			rel="stylesheet"
		/>
		<Analytics />
	</head>
	<body>
		<div class="page">
			<header class="header">
				<a href={home} class="brand-link">Nordwind Games</a>
				<nav class="nav">
					<a href={blogHome}>Devlog</a>
					<a href={altHref} hreflang={alt} lang={alt}>{altLabel}</a>
				</nav>
			</header>
			<main class="content">
				<slot />
			</main>
			<footer class="footer">
				<div class="footer-inner">
					<div class="footer-block">
						<span class="footer-label">{t.talk}</span>
						<a
							class="discord-link"
							href={DISCORD_INVITE}
							rel="noopener"
							data-analytics="outbound"
							data-analytics-id="discord"
							data-analytics-location="footer"
						>
							{t.discord}
						</a>
					</div>

					<div class="footer-block">
						<span class="footer-label">{t.follow}</span>
						<nav class="socials" aria-label={t.follow}>
							{
								SOCIAL_CHANNELS.map((channel) => (
									<a
										href={channel.url}
										class="social-btn"
										aria-label={channel.label}
										rel="noopener"
										data-analytics="outbound"
										data-analytics-id={channel.id}
										data-analytics-location="footer"
									>
										<svg
											width={channel.size}
											height={channel.size}
											viewBox="0 0 24 24"
											aria-hidden="true"
											set:html={channel.icon}
										/>
									</a>
								))
							}
						</nav>
					</div>
				</div>
			</footer>
		</div>
	</body>
</html>

<style>
	:global(html, body) {
		margin: 0;
		padding: 0;
		background: #eef2f7;
	}
	:global(*) {
		box-sizing: border-box;
	}
	:global(a) {
		color: inherit;
	}

	.page {
		--fg: rgba(93, 102, 112, 1);
		--muted: rgba(110, 125, 144, 1);
		--line: rgba(93, 102, 112, 0.24);
		--btnbg: rgba(255, 255, 255, 0.5);
		min-height: 100vh;
		min-height: 100dvh;
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		color: var(--fg);
		/* Column so the footer sits at the bottom of a short post, not mid-page. */
		display: flex;
		flex-direction: column;
	}

	.header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		flex-wrap: wrap;
		padding: 24px clamp(24px, 6vw, 96px);
		border-bottom: 2px solid var(--line);
	}

	.brand-link {
		font-family: Silkscreen, monospace;
		font-size: 18px;
		text-decoration: none;
	}

	.nav {
		display: flex;
		gap: 20px;
		font-size: 14px;
	}

	.nav a {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.content {
		width: 100%;
		max-width: 768px;
		margin: 0 auto;
		padding: 48px 24px 96px;
		flex: 1 0 auto;
		font-size: 17px;
		line-height: 1.7;
		/* A pasted URL or a long identifier would otherwise push the whole page
		   sideways; there is no other guard, and posts have neither yet. */
		overflow-wrap: anywhere;
	}
	.content :global(p) {
		margin: 1.2em 0;
	}

	/* ── footer ──────────────────────────────────────────────────────────── */

	.footer {
		border-top: 2px solid var(--line);
		padding: 32px clamp(24px, 6vw, 96px) 40px;
	}

	.footer-inner {
		max-width: 768px;
		margin: 0 auto;
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: space-between;
		gap: 28px;
	}

	.footer-block {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.footer-label {
		font-family: Silkscreen, monospace;
		font-size: 13px;
		letter-spacing: 0.04em;
		color: var(--muted);
	}

	.discord-link {
		align-self: flex-start;
		border: 2px solid var(--fg);
		background: var(--btnbg);
		padding: 10px 16px;
		font-size: 14px;
		text-decoration: none;
		box-shadow: 4px 4px 0 var(--line);
		transition:
			transform 110ms steps(2),
			box-shadow 110ms steps(2);
	}
	.discord-link:hover {
		transform: translate(2px, 2px);
		box-shadow: 2px 2px 0 var(--fg);
	}

	.socials {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.social-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 42px;
		height: 42px;
		border: 2px solid var(--fg);
		background: var(--btnbg);
		color: var(--fg);
		box-shadow: 4px 4px 0 var(--line);
		transition:
			transform 110ms steps(2),
			box-shadow 110ms steps(2);
	}
	.social-btn:hover {
		transform: translate(2px, 2px);
		box-shadow: 2px 2px 0 var(--fg);
	}

	.content :global(h1) {
		font-family: Silkscreen, monospace;
		font-weight: 400;
		font-size: clamp(24px, 4vw, 34px);
		line-height: 1.3;
	}

	.content :global(h2) {
		font-family: Silkscreen, monospace;
		font-weight: 400;
		font-size: clamp(17px, 4.5vw, 20px);
		margin-top: 2.5em;
	}

	.content :global(img) {
		max-width: 100%;
		height: auto;
		border: 2px solid var(--line);
	}

	.content :global(a) {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.content :global(pre) {
		overflow-x: auto;
		padding: 16px;
		border: 2px solid var(--line);
	}
	.content :global(pre code) {
		/* overflow-wrap on .content would otherwise break code mid-token. */
		overflow-wrap: normal;
		white-space: pre;
	}
	.content :global(table) {
		display: block;
		width: max-content;
		max-width: 100%;
		overflow-x: auto;
		border-collapse: collapse;
	}

	/* ── responsive ──────────────────────────────────────────────────────────
	 *
	 * max-width steps matching the analytics viewport buckets in
	 * src/lib/analytics/auto.ts. Nothing here applies at 1024px and up.
	 */

	@media (max-width: 1023px) {
		/* Header and footer links were 18px tall — the worst touch targets on the
		   site. The list links in posts stay inline: padding on an inline link in
		   running text would break the line box. */
		.nav a,
		.brand-link {
			display: inline-flex;
			align-items: center;
			min-height: 44px;
		}
		.nav {
			gap: 8px 20px;
			flex-wrap: wrap;
		}
		.discord-link {
			display: inline-flex;
			align-items: center;
			min-height: 44px;
		}
		.social-btn {
			width: 44px;
			height: 44px;
		}
	}

	@media (max-width: 639px) {
		.content {
			padding: 32px 20px 64px;
		}
	}
</style>
