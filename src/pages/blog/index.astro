---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { getPostsByLocale, postPath } from '../../lib/blog';
import { BLOG_INDEX_ALTERNATES, blogIndex, feedPath } from '../../lib/seo';
import { HOME_CRUMB, blog, breadcrumbs, identityNodes } from '../../lib/schema';

const posts = await getPostsByLocale('en');
const page = blogIndex('en');
const site = Astro.site!;
---

<BlogLayout
	title={page.title}
	description={page.description}
	locale="en"
	alternates={BLOG_INDEX_ALTERNATES}
	feed={feedPath('en')}
	jsonLd={[
		...identityNodes(site),
		blog(site, 'en', posts, (slug) => postPath('en', slug)),
		breadcrumbs(site, [HOME_CRUMB, { name: 'Devlog', path: page.path }]),
	]}
>
	<h1>Devlog</h1>
	{posts.length === 0 && <p>No posts yet — check back soon.</p>}
	<ul class="post-list">
		{
			posts.map((post) => (
				<li>
					<a href={postPath('en', post.slug)}>{post.data.title}</a>
					<p class="meta">
						{post.data.date.toISOString().slice(0, 10)} — {post.data.description}
					</p>
				</li>
			))
		}
	</ul>
</BlogLayout>

<style>
	.post-list {
		list-style: none;
		padding: 0;
		margin: 2em 0 0;
	}
	.post-list li {
		margin-bottom: 1.75em;
	}
	.post-list a {
		font-size: 18px;
	}
	@media (max-width: 1023px) {
		.post-list a {
			display: inline-flex;
			align-items: center;
			min-height: 44px;
		}
	}
	.meta {
		margin: 0.35em 0 0;
		font-size: 13px;
		color: var(--muted);
	}
</style>
