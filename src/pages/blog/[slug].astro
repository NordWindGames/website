---
import { render } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { getPostsByLocale, getTranslationPath, postPath } from '../../lib/blog';
import { blogIndex, feedPath, postAlternates } from '../../lib/seo';
import { HOME_CRUMB, blogPosting, breadcrumbs, identityNodes } from '../../lib/schema';

export async function getStaticPaths() {
	const posts = await getPostsByLocale('en');
	return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const altLocaleHref = await getTranslationPath('en', post.slug);
const alternates = await postAlternates('en', post.slug);
const site = Astro.site!;
const path = postPath('en', post.slug);
---

<BlogLayout
	title={`${post.data.title} — Nordwind Games Devlog`}
	description={post.data.description}
	locale="en"
	altLocaleHref={altLocaleHref}
	alternates={alternates}
	type="article"
	publishedTime={post.data.date}
	feed={feedPath('en')}
	jsonLd={[
		...identityNodes(site),
		blogPosting({
			site,
			locale: 'en',
			path,
			title: post.data.title,
			description: post.data.description,
			date: post.data.date,
			body: post.body,
		}),
		breadcrumbs(site, [
			HOME_CRUMB,
			{ name: 'Devlog', path: blogIndex('en').path },
			{ name: post.data.title, path },
		]),
	]}
>
	<h1>{post.data.title}</h1>
	<p class="meta">{post.data.date.toISOString().slice(0, 10)}</p>
	<Content />
</BlogLayout>

<style>
	.meta {
		font-size: 13px;
		color: var(--muted);
		margin-top: -1em;
	}
</style>
