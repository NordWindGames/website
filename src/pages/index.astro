---
import Analytics from '../components/Analytics.astro';
import { SOCIAL_CHANNELS } from '../lib/social';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Nordwind Games — indie game studio. Game: Hold Strong, coming soon." />
		<title>Nordwind Games</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Silkscreen:wght@400;700&display=swap"
			rel="stylesheet"
		/>
		<Analytics />
	</head>
	<body>
		<div class="site" id="site-root">
			<canvas id="storm-canvas" width="1280" height="720"></canvas>

			<div class="content">
				<header class="header">
					<div class="brand">
						<div class="brand-mark" aria-hidden="true">
							<span class="dim"></span><span></span><span class="dim"></span>
							<span></span><span></span><span></span>
							<span class="dim"></span><span></span><span class="dim"></span>
						</div>
						<h1 class="brand-title">Nordwind Games</h1>
					</div>

					<nav class="site-nav" aria-label="Site sections">
						<a
							class="nav-link"
							href="/blog/"
							data-analytics="cta"
							data-analytics-id="devlog"
							data-analytics-location="header"
							data-analytics-label="Devlog"
						>
							Devlog
						</a>
					</nav>

					<nav class="socials" aria-label="Social media">
						{
							SOCIAL_CHANNELS.map((channel) => (
								<a
									href={channel.url}
									aria-label={channel.label}
									class="social-btn"
									rel="noopener"
									data-analytics="outbound"
									data-analytics-id={channel.id}
									data-analytics-location="nav"
								>
									<svg
										width={channel.size}
										height={channel.size}
										viewBox="0 0 24 24"
										aria-hidden="true"
										set:html={channel.icon}
									/>
								</a>
							))
						}
					</nav>
				</header>

				<div class="hero">
					<div class="cta-jolt" id="cta-jolt">
						<div class="cta-shadow">
							<button
								type="button"
								class="cta"
								id="cta-button"
								data-analytics="cta"
								data-analytics-id="hold_strong_teaser"
								data-analytics-location="hero"
								data-analytics-label="Game: Hold Strong"
							>
								<span class="cta-dot"></span>
								Game: Hold Strong
								<span class="cta-badge">coming soon</span>
							</button>
						</div>
					</div>
				</div>
			</div>
		</div>

		<script>
			import { initStormCloud } from '../scripts/storm-cloud';

			initStormCloud({
				root: document.getElementById('site-root')!,
				canvas: document.getElementById('storm-canvas') as HTMLCanvasElement,
				button: document.getElementById('cta-button')!,
				jolt: document.getElementById('cta-jolt')!,
			});
		</script>
	</body>
</html>

<style>
	:global(html, body) {
		margin: 0;
		padding: 0;
		background: #eef2f7;
	}
	:global(*) {
		box-sizing: border-box;
	}
	:global(a) {
		color: inherit;
		text-decoration: none;
	}

	.site {
		--fg: rgba(93, 102, 112, 1);
		--muted: rgba(110, 125, 144, 1);
		--line: rgba(93, 102, 112, 0.24);
		--btnbg: rgba(255, 255, 255, 0.5);
		--btnfg: rgba(170, 173, 177, 1);
		--gamebg: var(--fg);
		--gamefg: var(--btnfg);
		--gameborder: var(--fg);
		--gamelift: 0px;
		--gameshadow: none;

		position: relative;
		width: 100%;
		min-height: 100vh;
		overflow: hidden;
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
	}

	#storm-canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
	}

	.content {
		position: relative;
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		padding: 40px clamp(24px, 6vw, 96px) 48px;
	}

	.header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		flex-wrap: wrap;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.brand-mark {
		display: grid;
		grid-template-columns: repeat(3, 4px);
		grid-template-rows: repeat(3, 4px);
		gap: 2px;
	}
	.brand-mark span {
		background: var(--fg);
	}
	.brand-mark span.dim {
		opacity: 0.25;
	}

	.brand-title {
		font-family: Silkscreen, monospace;
		font-weight: 400;
		font-size: clamp(19px, 2vw, 26px);
		line-height: 1;
		letter-spacing: 0.02em;
		color: var(--fg);
		margin: 0;
	}

	/* Text sibling of .social-btn: same pixel-art frame, sized for a word. */
	.site-nav {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.nav-link {
		display: inline-flex;
		align-items: center;
		height: 42px;
		padding: 0 18px;
		border: 2px solid var(--fg);
		background: var(--btnbg);
		color: var(--fg);
		font-family: Silkscreen, monospace;
		font-size: 13px;
		letter-spacing: 0.06em;
		box-shadow: 4px 4px 0 var(--line);
		transition:
			transform 110ms steps(2),
			box-shadow 110ms steps(2);
	}
	.nav-link:hover {
		transform: translate(2px, 2px);
		box-shadow: 2px 2px 0 var(--fg);
	}

	.socials {
		position: absolute;
		right: clamp(24px, 6vw, 96px);
		bottom: 48px;
		display: flex;
		align-items: center;
		justify-content: flex-end;
		flex-wrap: wrap;
		gap: 10px;
	}

	.social-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 42px;
		height: 42px;
		border: 2px solid var(--fg);
		background: var(--btnbg);
		color: var(--fg);
		box-shadow: 4px 4px 0 var(--line);
		transition:
			transform 110ms steps(2),
			box-shadow 110ms steps(2);
	}
	.social-btn:hover {
		transform: translate(2px, 2px);
		box-shadow: 2px 2px 0 var(--fg);
	}

	.hero {
		flex: 1 1 0%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding-top: 26vh;
		text-align: center;
	}

	.cta-jolt {
		display: inline-flex;
		will-change: transform;
		transform: translate3d(0, 0, 0);
		filter: none;
		text-shadow: none;
	}

	.cta-shadow {
		display: inline-flex;
		box-shadow: 9px 9px 0 var(--line);
	}

	.cta {
		display: inline-flex;
		align-items: center;
		gap: 14px;
		min-height: 60px;
		padding: 0 34px;
		border: 2px solid var(--gameborder);
		background: var(--gamebg);
		color: var(--gamefg);
		font-family: Silkscreen, monospace;
		font-size: 15px;
		font-weight: 400;
		letter-spacing: 0.06em;
		white-space: nowrap;
		cursor: pointer;
		transition:
			transform 160ms,
			letter-spacing 220ms;
		box-shadow: var(--gameshadow);
		transform: translateY(var(--gamelift));
	}
	.cta:hover {
		letter-spacing: 0.09em;
	}

	.cta-dot {
		width: 7px;
		height: 7px;
		background: currentcolor;
		display: inline-block;
	}

	.cta-badge {
		font-size: 13px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		white-space: nowrap;
		opacity: 0.62;
	}
</style>
