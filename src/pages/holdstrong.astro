---
import Analytics from '../components/Analytics.astro';
import Seo from '../components/Seo.astro';
import { DISCORD_INVITE } from '../lib/social';
import { GAME_NAME, HOLDSTRONG, OG_HOLDSTRONG } from '../lib/seo';
import { HOME_CRUMB, breadcrumbs, identityNodes, videoGame } from '../lib/schema';

const site = Astro.site!;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<Seo
			title={HOLDSTRONG.title}
			description={HOLDSTRONG.description}
			image={OG_HOLDSTRONG}
			jsonLd={[
				...identityNodes(site),
				videoGame(site),
				breadcrumbs(site, [HOME_CRUMB, { name: GAME_NAME, path: HOLDSTRONG.path }]),
			]}
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Grenze+Gotisch:wght@400;600;800&family=Barlow+Condensed:wght@400;500;600&family=Barlow:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<Analytics />
	</head>
	<body>
		<div class="hs-page">
			<div class="hs-hero">
				<img
					class="hs-hero-img"
					src="/holdstrong/keyart.png"
					alt=""
					width="1024"
					height="559"
					fetchpriority="high"
					decoding="async"
				/>
				<div class="hs-hero-overlay hs-hero-overlay-1"></div>
				<div class="hs-hero-overlay hs-hero-overlay-2"></div>

				<header class="hs-header">
					<a
						href="/"
						class="hs-brand"
						data-analytics="cta"
						data-analytics-id="studio_home"
						data-analytics-location="header"
						data-analytics-label="HoldStrong wordmark">HOLD<span class="accent">STRONG</span></a
					>
					<nav class="hs-nav" aria-label="Sections">
						<a href="#gods" data-analytics="cta" data-analytics-id="jump_gods" data-analytics-location="nav"
							>The Gods</a
						>
						<a
							href="#gallery"
							data-analytics="cta"
							data-analytics-id="jump_gallery"
							data-analytics-location="nav">Gallery</a
						>
						<a
							href="#demo"
							data-analytics="cta"
							data-analytics-id="jump_playtest"
							data-analytics-location="nav">Playtest</a
						>
						<!-- TODO(nordwind): no Steam page exists yet, so this stays href="#". The click is
						     still tracked on purpose - wishlist intent is the strongest pre-launch signal
						     there is, and it is worth measuring before the store page can absorb it. Point
						     this and the two below at the real URL as soon as there is one. -->
						<a href="#" class="hs-nav-cta" data-analytics="wishlist" data-analytics-location="nav"
							>Wishlist on Steam</a
						>
					</nav>
				</header>

				<div class="hs-hero-body">
					<h1 class="hs-title">HOLDSTRONG</h1>
					<p class="hs-tagline">
						An incremental Viking roguelike. You are an Einheri, sent back at every dawn to hold Rimehold —
						the last outpost before the Eternal Ice. The gods do not speak. They intervene.
					</p>

					<div class="hs-cta-row">
						<a
							href="#demo"
							class="hs-cta-primary"
							data-analytics="cta"
							data-analytics-id="join_playtest"
							data-analytics-location="hero">Join the Playtest</a
						>
						<a href="#" class="hs-cta-secondary" data-analytics="wishlist" data-analytics-location="hero"
							>Add to wishlist</a
						>
					</div>

					<div class="hs-tags">
						<span class="hs-tag">PC · Steam</span>
						<span class="hs-tag">Single player</span>
						<span class="hs-tag">Roguelike · Incremental</span>
					</div>
				</div>
			</div>

			<section class="hs-countdown" data-analytics-section="countdown">
				<div class="hs-countdown-inner">
					<div>
						<div class="hs-eyebrow hs-eyebrow-blue">The demo opens the gates in</div>
						<div class="hs-countdown-date">16 October 2026 · free on Steam</div>
					</div>
					<div class="hs-countdown-units">
						<div class="hs-countdown-unit">
							<div class="hs-countdown-value" id="hs-days">0</div>
							<div class="hs-countdown-label">Days</div>
						</div>
						<div class="hs-countdown-unit">
							<div class="hs-countdown-value" id="hs-hours">00</div>
							<div class="hs-countdown-label">Hours</div>
						</div>
						<div class="hs-countdown-unit">
							<div class="hs-countdown-value" id="hs-minutes">00</div>
							<div class="hs-countdown-label">Minutes</div>
						</div>
						<div class="hs-countdown-unit">
							<div class="hs-countdown-value" id="hs-seconds">00</div>
							<div class="hs-countdown-label">Seconds</div>
						</div>
					</div>
				</div>
			</section>

			<section id="gods" class="hs-section" data-analytics-section="gods">
				<div class="hs-eyebrow hs-eyebrow-purple">Three orbs, one day of the endless battle</div>
				<h2 class="hs-h2">The gods do not speak. They intervene.</h2>
				<p class="hs-lead">
					Three gods reach into the fight — a bolt on the horizon, a second shape at your side, a duel nobody
					else survives. Odin grants no orb: he is the one who carries you to the hall and sends you back.
				</p>

				<div class="hs-gods-grid">
					<div class="hs-god-card" data-god="thor">
						<div class="hs-god-rune" style="color:#ff9d5c">ᚦ</div>
						<div class="hs-god-epithet" style="color:#ff9d5c">The loudest help</div>
						<div class="hs-god-name">Thor</div>
						<p class="hs-god-body">
							Chain lightning off the tower. The god who helps in the most visible way there is — every arc
							jumps to the next thing the ice sent.
						</p>
						<div class="hs-god-perk">Orb · Chain lightning</div>
					</div>
					<div class="hs-god-card" data-god="loki">
						<div class="hs-god-rune" style="color:#a271ff">ᚷ</div>
						<div class="hs-god-epithet" style="color:#a271ff">He sends no one</div>
						<div class="hs-god-name">Loki</div>
						<p class="hs-god-body">
							A static double of you, standing where you are not. He helps, but on his own terms: he sends
							nobody, he deceives.
						</p>
						<div class="hs-god-perk">Orb · Static doppelgänger</div>
					</div>
					<div class="hs-god-card" data-god="tyr">
						<div class="hs-god-rune" style="color:#7fd4ff">ᛏ</div>
						<div class="hs-god-epithet" style="color:#7fd4ff">An old debt</div>
						<div class="hs-god-name">Týr</div>
						<p class="hs-god-body">
							The single combat. He bound Fenrir and lost the hand for it — and the Fenrir brood hunting you
							is that same bloodline. He answers for one enemy only, and that one is decided.
						</p>
						<div class="hs-god-perk">Orb · Duel, single target</div>
					</div>
				</div>
			</section>

			<section id="gallery" class="hs-gallery" data-analytics-section="gallery">
				<div class="hs-section">
					<div class="hs-gallery-head">
						<h2 class="hs-h2">From the build</h2>
						<div class="hs-gallery-note">Pre-alpha capture · art not final</div>
					</div>
					<div class="hs-gallery-body">
						<div class="hs-gallery-slot hs-gallery-slot-wide">Wide gameplay shot — the tower under siege</div>
						<!--
						  display:contents above 639px, so the two grids below stay direct grid items of
						  .hs-gallery-body and the desktop layout is exactly the one it always was. Below
						  640px this element becomes the scroll-snap carousel and the five slots become its
						  slides - which only works if they share a single parent, hence the wrapper.
						-->
						<div class="hs-gallery-scroll" id="hs-gallery-scroll">
							<div class="hs-gallery-grid-main">
								<div class="hs-gallery-slot">Upgrade / rune screen</div>
								<div class="hs-gallery-slot">Boss or god encounter</div>
							</div>
							<div class="hs-gallery-grid-secondary">
								<div class="hs-gallery-slot hs-gallery-slot-short">Combat</div>
								<div class="hs-gallery-slot hs-gallery-slot-short">World map</div>
								<div class="hs-gallery-slot hs-gallery-slot-short">Loot / meta progression</div>
							</div>
						</div>
					</div>
					<!-- Carousel position indicator. Display only, never a control. -->
					<div class="hs-gallery-dots" id="hs-gallery-dots" aria-hidden="true">
						<span></span><span></span><span></span><span></span><span></span>
					</div>
				</div>
			</section>

			<section id="demo" class="hs-demo" data-analytics-section="playtest">
				<div class="hs-demo-glow"></div>
				<div class="hs-demo-inner">
					<h2 class="hs-h2">Join the Playtest</h2>
					<p class="hs-lead hs-lead-centered">
						Play HoldStrong before the demo goes public on 16 October — and shape it. We hand out keys to a
						small group, read every report, and change the build from what you tell us.
					</p>

					<div class="hs-feature-grid">
						<div class="hs-feature-card">
							<div class="hs-feature-title" style="color:#7fd4ff">Early access</div>
							<p class="hs-feature-body">A Steam key for the test build, weeks ahead of the public demo.</p>
						</div>
						<div class="hs-feature-card">
							<div class="hs-feature-title" style="color:#ff9d5c">Direct line to us</div>
							<p class="hs-feature-body">
								A private Discord channel with the devs and a short feedback form per build.
							</p>
						</div>
						<div class="hs-feature-card">
							<div class="hs-feature-title" style="color:#c3a6ff">Named in the credits</div>
							<p class="hs-feature-body">Everyone who plays and reports gets their name in the game.</p>
						</div>
					</div>

					<div class="hs-signup-success" id="hs-success" hidden>
						<div class="hs-signup-success-title">You're on the playtest list.</div>
						<p class="hs-signup-success-body">
							We'll send your test key and the feedback brief to <span id="hs-success-email"></span> before 16 October.
						</p>
					</div>

					<!-- novalidate: the form does its own checking and renders the result into
					     .hs-error, styled to match the page. Native constraint validation would
					     preempt that - it blocks the submit event entirely, so neither the custom
					     message nor the funnel events would ever be reached. type/required stay on
					     the input for the mobile keyboard and for assistive technology. -->
					<form class="hs-signup-form" id="hs-signup-form" novalidate>
						<div class="hs-signup-row">
							<input
								type="email"
								id="hs-email-input"
								placeholder="you@midgard.com"
								class="hs-input"
								required
							/>
							<button type="submit" class="hs-submit-btn">Apply as tester</button>
						</div>
						<div class="hs-error" id="hs-error" role="alert"></div>
					</form>
				</div>
			</section>

			<footer class="hs-footer">
				<div class="hs-footer-inner">
					<div class="hs-footer-brand">HOLD<span class="accent">STRONG</span></div>
					<div class="hs-footer-links">
						<a
							href={DISCORD_INVITE}
							class="hs-footer-link hs-footer-link-discord"
							rel="noopener"
							data-analytics="outbound"
							data-analytics-id="discord"
							data-analytics-location="footer"
						>
							Discord
						</a>
						<a
							href="#"
							class="hs-footer-link hs-footer-link-steam"
							data-analytics="wishlist"
							data-analytics-location="footer">Steam</a
						>
						<a
							href="/blog/"
							class="hs-footer-link hs-footer-link-devlog"
							data-analytics="cta"
							data-analytics-id="devlog"
							data-analytics-location="footer">Devlog</a
						>
						<a
							href="/"
							class="hs-footer-link hs-footer-link-studio"
							data-analytics="cta"
							data-analytics-id="studio_home"
							data-analytics-location="footer">Nordwind Games</a
						>
					</div>
					<div class="hs-copyright">© 2026 · Made by Nordwind Games</div>
				</div>
			</footer>
		</div>

		<script>
			import { initHoldStrong } from '../scripts/holdstrong';

			initHoldStrong({
				days: document.getElementById('hs-days')!,
				hours: document.getElementById('hs-hours')!,
				minutes: document.getElementById('hs-minutes')!,
				seconds: document.getElementById('hs-seconds')!,
				form: document.getElementById('hs-signup-form') as HTMLFormElement,
				emailInput: document.getElementById('hs-email-input') as HTMLInputElement,
				error: document.getElementById('hs-error')!,
				success: document.getElementById('hs-success')!,
				successEmail: document.getElementById('hs-success-email')!,
				godCards: Array.from(document.querySelectorAll<HTMLElement>('[data-god]')),
				galleryScroll: document.getElementById('hs-gallery-scroll'),
				galleryDots: document.getElementById('hs-gallery-dots'),
			});
		</script>
	</body>
</html>

<style>
	:global(html, body) {
		margin: 0;
		padding: 0;
		background: #070a11;
	}
	:global(*) {
		box-sizing: border-box;
	}
	:global(a) {
		text-decoration: none;
	}

	.hs-page {
		background: #070a11;
		color: #c9d2e0;
		font-family: Barlow, system-ui, sans-serif;
	}

	.accent {
		color: #ff7a2f;
	}

	/* hero */

	.hs-hero {
		position: relative;
		min-height: 820px;
		display: flex;
		flex-direction: column;
	}
	.hs-hero-img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 35%;
	}
	.hs-hero-overlay {
		position: absolute;
		inset: 0;
	}
	.hs-hero-overlay-1 {
		background: linear-gradient(
			180deg,
			rgba(7, 10, 17, 0.72) 0%,
			rgba(7, 10, 17, 0.35) 32%,
			rgba(7, 10, 17, 0.82) 72%,
			#070a11 100%
		);
	}
	.hs-hero-overlay-2 {
		background: radial-gradient(ellipse 70% 55% at 50% 45%, rgba(0, 0, 0, 0) 40%, rgba(7, 10, 17, 0.75) 100%);
	}

	.hs-header {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		padding: 26px 48px;
		flex-wrap: wrap;
	}
	.hs-brand {
		font-family: 'Grenze Gotisch', serif;
		font-size: 26px;
		font-weight: 800;
		letter-spacing: 0.04em;
		color: #f0e6d6;
	}
	.hs-nav {
		display: flex;
		align-items: center;
		gap: 28px;
		font-family: 'Barlow Condensed', sans-serif;
		font-size: 15px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: #8b97ab;
		flex-wrap: wrap;
	}
	.hs-nav a {
		color: #8b97ab;
		white-space: nowrap;
	}
	.hs-nav-cta {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 9px 18px;
		border: 1px solid rgba(255, 122, 47, 0.45);
		color: #ffb066 !important;
	}

	.hs-hero-body {
		position: relative;
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		padding: 80px 32px 96px;
	}
	.hs-title {
		margin: 0;
		font-family: 'Grenze Gotisch', serif;
		font-weight: 800;
		font-size: clamp(64px, 9.5vw, 148px);
		line-height: 0.86;
		letter-spacing: 0.01em;
		color: #f4ece0;
		text-shadow:
			0 0 60px rgba(255, 122, 47, 0.35),
			0 8px 40px rgba(0, 0, 0, 0.8);
	}
	.hs-tagline {
		margin: 28px 0 0;
		max-width: 660px;
		font-size: 20px;
		line-height: 1.6;
		color: #b3bfd1;
	}
	.hs-cta-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 14px;
		margin-top: 38px;
	}
	.hs-cta-primary {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 17px 34px;
		background: linear-gradient(180deg, #ff8c3f, #e35f14);
		color: #180a02;
		font-family: 'Barlow Condensed', sans-serif;
		font-size: 18px;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		white-space: nowrap;
		box-shadow:
			0 0 0 1px rgba(255, 180, 120, 0.4),
			0 16px 40px -12px rgba(255, 122, 47, 0.7);
		transition: filter 150ms;
	}
	.hs-cta-primary:hover {
		filter: brightness(1.08);
	}
	.hs-cta-secondary {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 17px 30px;
		border: 1px solid rgba(201, 210, 224, 0.28);
		color: #dbe3ef;
		font-family: 'Barlow Condensed', sans-serif;
		font-size: 18px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		white-space: nowrap;
		background: rgba(10, 15, 25, 0.5);
		transition: border-color 150ms;
	}
	.hs-cta-secondary:hover {
		border-color: rgba(201, 210, 224, 0.6);
	}
	.hs-tags {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 10px;
		margin-top: 44px;
		font-family: 'Barlow Condensed', sans-serif;
		font-size: 13px;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: #7b8699;
	}
	.hs-tag {
		padding: 7px 14px;
		border: 1px solid rgba(123, 134, 153, 0.28);
	}

	/* countdown */

	.hs-countdown {
		border-top: 1px solid rgba(127, 212, 255, 0.12);
		border-bottom: 1px solid rgba(127, 212, 255, 0.12);
		background: linear-gradient(180deg, #0a101c, #070a11);
	}
	.hs-countdown-inner {
		max-width: 1120px;
		margin: 0 auto;
		padding: 44px 48px;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 32px;
	}
	.hs-countdown-date {
		font-family: 'Grenze Gotisch', serif;
		font-size: 22px;
		color: #e8dfd0;
		margin-top: 6px;
	}
	.hs-countdown-units {
		display: flex;
		gap: 14px;
	}
	.hs-countdown-unit {
		min-width: 104px;
		padding: 16px 10px;
		text-align: center;
		background: rgba(15, 22, 36, 0.9);
		border: 1px solid rgba(255, 122, 47, 0.22);
	}
	.hs-countdown-value {
		font-family: 'Grenze Gotisch', serif;
		font-size: 44px;
		line-height: 1;
		color: #ff9d5c;
	}
	.hs-countdown-label {
		margin-top: 8px;
		font-family: 'Barlow Condensed', sans-serif;
		font-size: 12px;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		color: #78849a;
	}

	/* shared section bits */

	.hs-section {
		max-width: 1120px;
		margin: 0 auto;
		padding: 100px 48px;
	}
	.hs-eyebrow {
		font-family: 'Barlow Condensed', sans-serif;
		font-size: 13px;
		letter-spacing: 0.32em;
		text-transform: uppercase;
	}
	.hs-eyebrow-blue {
		color: #7fd4ff;
		letter-spacing: 0.3em;
	}
	.hs-eyebrow-purple {
		color: #a271ff;
	}
	.hs-h2 {
		margin: 14px 0 0;
		font-family: 'Grenze Gotisch', serif;
		font-weight: 600;
		font-size: 52px;
		line-height: 1.05;
		color: #f0e7d9;
	}
	.hs-lead {
		margin: 16px 0 0;
		max-width: 600px;
		font-size: 17px;
		line-height: 1.65;
		color: #93a0b4;
	}
	.hs-lead-centered {
		margin-left: auto;
		margin-right: auto;
		max-width: 660px;
		text-align: center;
		font-size: 18px;
	}

	/* gods */

	.hs-gods-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 20px;
		margin-top: 48px;
	}
	.hs-god-card {
		position: relative;
		padding: 34px 30px 30px;
		background: linear-gradient(180deg, rgba(17, 25, 41, 0.95), rgba(10, 15, 25, 0.95));
		border: 1px solid rgba(127, 212, 255, 0.14);
		overflow: hidden;
		transition: border-color 150ms;
	}
	@media (hover: hover) {
		.hs-god-card:hover {
			border-color: rgba(255, 122, 47, 0.4);
		}
	}
	.hs-god-rune {
		position: absolute;
		top: -40px;
		right: -20px;
		font-family: 'Grenze Gotisch', serif;
		font-size: 150px;
		line-height: 1;
		opacity: 0.13;
	}
	.hs-god-epithet {
		position: relative;
		font-family: 'Barlow Condensed', sans-serif;
		font-size: 12px;
		letter-spacing: 0.3em;
		text-transform: uppercase;
	}
	.hs-god-name {
		position: relative;
		margin-top: 10px;
		font-family: 'Grenze Gotisch', serif;
		font-size: 38px;
		color: #f0e7d9;
	}
	.hs-god-body {
		position: relative;
		margin: 14px 0 0;
		font-size: 16px;
		line-height: 1.6;
		color: #93a0b4;
	}
