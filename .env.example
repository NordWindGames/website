# Copy to .env for local development. Both files are gitignored except this one.

# Google Analytics 4 measurement ID (G-XXXXXXXXXX).
# Leave empty to disable the tag entirely — `astro dev` then only logs the
# events it would have sent to the browser console.
# In CI/CD this comes from the GitHub Actions repository variable of the same
# name (Settings -> Secrets and variables -> Actions -> Variables).
PUBLIC_GA_MEASUREMENT_ID=
